diff --color -ruN a/integrationtests/self/connection_migration_dead_path_test.go b/integrationtests/self/connection_migration_dead_path_test.go
--- a/integrationtests/self/connection_migration_dead_path_test.go
+++ b/integrationtests/self/connection_migration_dead_path_test.go
@@ -0,0 +1,124 @@
+package self_test
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go"
+	quicproxy "github.com/quic-go/quic-go/integrationtests/tools/proxy"
+
+	"github.com/stretchr/testify/require"
+)
+
+// A client must be able to migrate away from a path that stopped delivering
+// packets while data was in flight. The congestion window on the dead path
+// never opens again, so the PATH_CHALLENGE for the new path has to be sent
+// regardless of the send mode of the current path.
+func TestConnectionMigrationAwayFromDeadPath(t *testing.T) {
+	// Large windows, so that the sender is limited by congestion control, not
+	// by flow control, when the path dies.
+	windows := &quic.Config{
+		InitialStreamReceiveWindow:     64 << 20,
+		MaxStreamReceiveWindow:         64 << 20,
+		InitialConnectionReceiveWindow: 64 << 20,
+		MaxConnectionReceiveWindow:     64 << 20,
+	}
+	ln, err := quic.ListenAddr("localhost:0", getTLSConfig(), getQuicConfig(windows))
+	require.NoError(t, err)
+	defer ln.Close()
+
+	tr1 := &quic.Transport{Conn: newUDPConnLocalhost(t)}
+	defer tr1.Close()
+	tr2 := &quic.Transport{Conn: newUDPConnLocalhost(t)}
+	defer tr2.Close()
+
+	var path1Dead atomic.Bool
+	isPath1 := func(dir quicproxy.Direction, from, to net.Addr) bool {
+		var port int
+		switch dir {
+		case quicproxy.DirectionIncoming:
+			port = from.(*net.UDPAddr).Port
+		case quicproxy.DirectionOutgoing:
+			port = to.(*net.UDPAddr).Port
+		}
+		return port == tr1.Conn.LocalAddr().(*net.UDPAddr).Port
+	}
+	const rtt = 10 * time.Millisecond
+	proxy := quicproxy.Proxy{
+		Conn:       newUDPConnLocalhost(t),
+		ServerAddr: ln.Addr().(*net.UDPAddr),
+		DropPacket: func(dir quicproxy.Direction, from, to net.Addr, _ []byte) bool {
+			return path1Dead.Load() && isPath1(dir, from, to)
+		},
+		DelayPacket: func(quicproxy.Direction, net.Addr, net.Addr, []byte) time.Duration { return rtt / 2 },
+	}
+	require.NoError(t, proxy.Start())
+	defer proxy.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+
+	conn, err := tr1.Dial(ctx, proxy.LocalAddr(), getTLSClientConfig(), getQuicConfig(windows))
+	require.NoError(t, err)
+	defer conn.CloseWithError(0, "")
+	sconn, err := ln.Accept(ctx)
+	require.NoError(t, err)
+	defer sconn.CloseWithError(0, "")
+
+	data := make([]byte, 48<<20)
+	_, _ = rand.Read(data)
+
+	var received atomic.Int64
+	errChan := make(chan error, 1)
+	go func() {
+		str, err := sconn.AcceptUniStream(ctx)
+		if err != nil {
+			errChan <- err
+			return
+		}
+		var buf bytes.Buffer
+		_, err = io.Copy(&buf, io.TeeReader(str, writerFunc(func(p []byte) { received.Add(int64(len(p))) })))
+		if err == nil && !bytes.Equal(buf.Bytes(), data) {
+			err = io.ErrUnexpectedEOF
+		}
+		errChan <- err
+	}()
+
+	str, err := conn.OpenUniStream()
+	require.NoError(t, err)
+	go func() {
+		_, _ = str.Write(data)
+		_ = str.Close()
+	}()
+
+	// let the transfer get going, then kill path 1 with data in flight
+	require.Eventually(t, func() bool { return received.Load() > 256<<10 }, 5*time.Second, time.Millisecond)
+	path1Dead.Store(true)
+	// An application notices a dead path only after a while (a keepalive
+	// timeout); by then the connection is in PTO backoff on path 1.
+	time.Sleep(2 * time.Second)
+
+	path, err := conn.AddPath(tr2)
+	require.NoError(t, err)
+	probeCtx, probeCancel := context.WithTimeout(ctx, 3*time.Second)
+	defer probeCancel()
+	require.NoError(t, path.Probe(probeCtx), "the new path was never validated")
+	require.NoError(t, path.Switch())
+
+	select {
+	case err := <-errChan:
+		require.NoError(t, err)
+	case <-ctx.Done():
+		t.Fatalf("transfer did not finish after the switch: %d of %d bytes", received.Load(), len(data))
+	}
+}
+
+type writerFunc func([]byte)
+
+func (f writerFunc) Write(p []byte) (int, error) { f(p); return len(p), nil }
