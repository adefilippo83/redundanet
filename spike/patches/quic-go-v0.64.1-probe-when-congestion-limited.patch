+// maybeSendPathProbe sends one pending path probe. Probes go out whatever the
+// send mode of the current path: a client migrating away from a dead path is
+// congestion limited on it, and must still be able to probe the new one.
+func (c *Conn) maybeSendPathProbe(now monotime.Time) (bool, error) {
+	if c.perspective != protocol.PerspectiveClient || !c.handshakeConfirmed {
+		return false, nil
+	}
+	pm := c.pathManagerOutgoing.Load()
+	if pm == nil {
+		return false, nil
+	}
+	connID, frame, tr, ok := pm.NextPathToProbe()
+	if !ok {
+		return false, nil
+	}
+	probe, buf, err := c.packer.PackPathProbePacket(connID, []ackhandler.Frame{frame}, c.version)
+	if err != nil {
+		return false, err
+	}
+	c.logger.Debugf("sending path probe packet from %s", c.LocalAddr())
+	c.logShortHeaderPacket(probe, protocol.ECNNon, buf.Len())
+	c.registerPackedShortHeaderPacket(probe, protocol.ECNNon, now)
+	tr.WriteTo(buf.Data, c.conn.RemoteAddr())
+	return true, nil
+}
