[Unit]
Description=RedundaNet Docker Containers
Documentation=https://github.com/yourorg/redundanet
After=network-online.target docker.service redundanet-init.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/redundanet/docker
# The env file written by 'redundanet network join' lives one level up, so it
# must be passed explicitly (compose only auto-loads .env from its own dir).
# RedundaNet Pi nodes are storage nodes by default (tinc_vpn + tahoe_storage).
ExecStart=/usr/bin/docker compose --env-file /opt/redundanet/.env --profile storage up -d
ExecStop=/usr/bin/docker compose --env-file /opt/redundanet/.env --profile storage down
ExecReload=/usr/bin/docker compose --env-file /opt/redundanet/.env --profile storage restart
TimeoutStartSec=300

# Run as root for Docker access
User=root
Group=root

[Install]
WantedBy=multi-user.target
