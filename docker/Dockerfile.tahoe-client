# Tahoe-LAFS Client container for RedundaNet
#
# Derives from the tahoe-base image (Python + Tahoe + the locked dependencies);
# only RedundaNet's source and this role's entrypoints are added, so the image
# builds in seconds. CI pins TAHOE_BASE to the base built from this checkout's
# poetry.lock (.github/workflows/tahoe-base.yml); the default serves local
# builds (docker-compose.build.yml, the e2e scripts).
ARG TAHOE_BASE=ghcr.io/adefilippo83/redundanet-tahoe-base:latest
FROM ${TAHOE_BASE}

LABEL org.opencontainers.image.title="RedundaNet Tahoe Client"
LABEL org.opencontainers.image.description="Tahoe-LAFS client for RedundaNet"

WORKDIR /app
COPY src/ ./src/
COPY docker/entrypoints/tahoe_client.py ./entrypoint.py
COPY docker/entrypoints/lease_renew.sh ./lease_renew.sh
COPY docker/entrypoints/backup_sync.py ./backup_sync.py
COPY docker/entrypoints/rebalance.py ./rebalance.py
COPY docker/supervisord/tahoe-client.conf /etc/supervisor/conf.d/tahoe-client.conf

RUN mkdir -p /var/lib/redundanet/manifest \
    /var/lib/tahoe-client \
    /var/log/redundanet \
    /mnt/redundanet

EXPOSE 3456/tcp

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD nc -z 127.0.0.1 4456 || exit 1

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/tahoe-client.conf"]
