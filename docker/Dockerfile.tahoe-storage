# Tahoe-LAFS Storage container for RedundaNet
#
# Derives from the tahoe-base image (Python + Tahoe + the locked dependencies);
# only RedundaNet's source and this role's entrypoints are added, so the image
# builds in seconds. CI pins TAHOE_BASE to the base built from this checkout's
# poetry.lock (.github/workflows/tahoe-base.yml); the default serves local
# builds (docker-compose.build.yml, the e2e scripts).
ARG TAHOE_BASE=ghcr.io/adefilippo83/redundanet-tahoe-base:latest
FROM ${TAHOE_BASE}

LABEL org.opencontainers.image.title="RedundaNet Tahoe Storage"
LABEL org.opencontainers.image.description="Tahoe-LAFS storage node for RedundaNet"

WORKDIR /app
COPY src/ ./src/
COPY docker/entrypoints/tahoe_storage.py ./entrypoint.py
COPY docker/entrypoints/share_census.py ./share_census.py
COPY docker/supervisord/tahoe-storage.conf /etc/supervisor/conf.d/tahoe-storage.conf

RUN mkdir -p /var/lib/redundanet/manifest \
    /var/lib/tahoe-storage \
    /var/log/redundanet \
    /data/storage

EXPOSE 3457/tcp

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD nc -z 127.0.0.1 4457 || exit 1

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/tahoe-storage.conf"]
