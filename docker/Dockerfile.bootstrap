# RedundaNet bootstrap hub: Tinc VPN entry point + Tahoe introducer in ONE image.
#
# Built for single-VM platforms (fly.io Machines, any small VPS with Docker):
# a VM is one network namespace, which is exactly what the compose stack
# emulates with `network_mode: service:tinc` — so tincd, the manifest-sync
# sidecar, the Tahoe introducer, and the FURL publisher all run here under one
# supervisord. See docs/bootstrap-hub.md for the deployment runbook.
FROM python:3.11-slim AS builder

# piwheels supplies prebuilt 32-bit ARM (armv7/armv6) wheels that PyPI lacks;
# pip merges indexes per-arch, so amd64/arm64 keep using PyPI manylinux wheels.
ENV PIP_EXTRA_INDEX_URL=https://www.piwheels.org/simple

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install poetry==1.7.1
WORKDIR /app
COPY pyproject.toml poetry.lock* ./
# Install deps via pip (not 'poetry install') so PIP_EXTRA_INDEX_URL/piwheels is
# honored; poetry only resolves the locked versions into a requirements file.
RUN poetry config virtualenvs.create false \
    && poetry export --only main --without-hashes -f requirements.txt -o /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt

# Install Tahoe-LAFS
# pyOpenSSL >= 25 removed OpenSSL.crypto.X509Req, which foolscap (Tahoe's RPC
# layer) still uses via Twisted's certificateRequest — an unpinned install
# crashes every Tahoe node at startup. service-identity is pinned alongside
# because its newer releases require a newer cryptography than pyopenssl<25
# resolves to.
RUN pip install "tahoe-lafs==1.20.0" "pyopenssl<25" "service-identity<25"

# Final stage
FROM python:3.11-slim

LABEL org.opencontainers.image.title="RedundaNet Bootstrap Hub"
LABEL org.opencontainers.image.description="Tinc VPN entry node + Tahoe introducer for RedundaNet"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    REDUNDANET_LOG_LEVEL=INFO

RUN apt-get update && apt-get install -y --no-install-recommends \
    tinc \
    gnupg \
    iproute2 \
    iputils-ping \
    netcat-openbsd \
    procps \
    git \
    supervisor \
    libffi8 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /app
COPY src/ ./src/
COPY docker/entrypoints/tinc.py ./entrypoint.py
COPY docker/entrypoints/manifest_sync.py ./manifest_sync.py
COPY docker/entrypoints/tahoe_introducer.py ./introducer_entrypoint.py
COPY docker/entrypoints/hub_boot.sh ./hub_boot.sh
COPY docker/supervisord/bootstrap.conf /etc/supervisor/conf.d/bootstrap.conf
RUN chmod +x ./hub_boot.sh

RUN mkdir -p /var/lib/redundanet/manifest \
    /var/lib/tahoe-introducer \
    /var/log/redundanet \
    /etc/tinc/redundanet/hosts \
    /root/.gnupg

EXPOSE 655/tcp 655/udp 3458/tcp

# Healthy = the VPN interface is up AND the introducer published its FURL.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD ip link show redundanet | grep -q UP \
        && test -s /var/lib/tahoe-introducer/private/introducer.furl || exit 1

CMD ["/app/hub_boot.sh"]
